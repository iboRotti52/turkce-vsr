# S3 Veri Deposu ve AWS Kimlik Bilgileri
# Bu dosyayı .env olarak kopyalayıp kullanabilirsiniz: cp .env.example .env
# ÖNEMLİ: Gerçek anahtarları asla GitHub'a commitlemeyin. Değerleri
# arkadaşınıza güvenli kanaldan (1Password, AWS IAM yeni kullanıcı vb.) paylaşın.
# Eski anahtarlar sızdığı için AWS konsoldan rotate/deactivate edin.

# S3 Kova Bilgileri
S3_BUCKET_NAME=YOUR_S3_BUCKET_NAME
AWS_DEFAULT_REGION=us-east-1

# AWS Erişim Anahtarları (örnek — gerçek değerleri .env dosyanıza yazın)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Yeni büyük veri artık Hugging Face'te tutuluyor:
# HF_DATASET_ID=YOUR_HF_USERNAME/turkce-vsr-buyuk-veri
